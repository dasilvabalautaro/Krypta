# --- Gradle / Android Studio ---
*.iml
.gradle
.kotlin
build/
/captures
.externalNativeBuild
.cxx
.DS_Store

# Rutas locales de la máquina (SDK), generado por Android Studio.
local.properties

# --- Secretos ---
# Credenciales de firma de release. El keystore vive fuera del repo
# (~/keystores/krypta/krypta.jks); ver hasReleaseKeystore en app/build.gradle.kts.
/keystore.properties

# Exportaciones de la bóveda de notas del autor (se regeneran allí, no aquí).
/compare-signal.pdf
/comparacion*.pdf
*.jks
*.keystore
# Notas locales del autor que no se versionan.
/keys-git.md

# Datos de usuario que pueden acabar en el árbol al depurar (el repo es público desde el
# 12 sep 2026): copias de seguridad de identidad y bases sacadas del móvil con `run-as`.
*.krbk
*.db
*.db-wal
*.db-shm
*.db-journal

# --- Artefactos de compilación fuera de build/ ---
# APK/AAB de release que Android Studio deja en app/release/.
/app/release/

# El AAR de gomobile (~75 MB) NO se versiona: se regenera con
# native-bridge/libp2p/build-aar.sh (necesita Go + gomobile + NDK 26.1.10909125).
# Un clon limpio debe ejecutarlo ANTES del primer ./gradlew :app:assembleDebug.
/native-bridge/libs/*.aar
/native-bridge/libs/*-sources.jar

# Binarios del nodo infra (salida de `go build`, ~190 MB). Se regeneran con los
# comandos de infra/node/README.md.
/infra/node/node
/infra/node/dist/

# Identidad privada del nodo de infraestructura. `go run .` en infra/node la crea ahí
# (el flag -key es relativo y vale `node.key` por defecto): es la clave con la que el nodo
# demuestra su PeerID, o sea infraestructura de producción, y NO debe subirse jamás.
/infra/node/*.key
# Buzón local de pruebas: se crea junto al node.key y contiene sobres E2EE de usuarios.
/infra/node/mailbox/

# --- IDE (ficheros por usuario) ---
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
/.idea/deploymentTargetSelector.xml
